# Core run setup
PYTHON_BIN=/workspace/conda-envs/anc/bin/python
DATASET=gmner
MODEL_NAME=FacebookAI/xlm-roberta-large
SEED=45
EPOCHS=6
BATCH_SIZE=4
LR=5e-06
TEMPERATURE=0.8
SAVE_BEST=0

# Loss weights
LOSS_CE_W=0.0
LOSS_CONS_W=0.0
LOSS_EXCL_W=0.3
LOSS_MARGIN_W=1.0

# Consistency
CONS_ALPHA=0.3
CONS_SIM_THR=-1.0
CONS_TARGET_POOL=mean
CONS_HARD_TOPK=0
CONS_INCLUDE_INTRA=0
CONS_WEIGHTED_SIM=0
CONS_SIM_TAU=0.1
CONS_SIM_MIN=-1.0
CONS_SIM_WEIGHT_CAP=5.0

# Exclusion (pairwise + iou)
EXCL_MARGIN=0.3
EXCL_TOPK=0
EXCL_MODE=sim_prob
EXCL_VARIANT=pairwise
EXCL_ENT_NAME_W=0.7
EXCL_ENT_TYPE_W=0.3
EXCL_PAIR_ALPHA=0.5
EXCL_PAIR_BETA=0.3
EXCL_PAIR_REGION_SIM=iou
EXCL_PAIR_TYPE_MODE=neutral
EXCL_PAIR_TYPE_FACTOR=1.5
EXCL_PAIR_NAME_THR=0.5
EXCL_PAIR_REGION_THR=0.5
EXCL_PAIR_EASY_SCALE=0.5
EXCL_PAIR_HARD_SCALE=1.5

# Ranking
RANK_MARGIN=0.5
RANK_TOPK=5

# Anchor selection
ANCHOR_SELECT_MODE=mlp
ANCHOR_TOPK=1
ANCHOR_SOFTMAX_TEMP=1.0
ANCHOR_USE_RELIABILITY=1
ANCHOR_REL_GAP_TEMP=0.1

# Multi-view weights (feature off but keep explicit values)
USE_MULTI_VIEW=0
MV_W_ENT=0.65
MV_W_KNOW=0.2
MV_W_TYPE=0.15
MV_W_CTX=0.0
